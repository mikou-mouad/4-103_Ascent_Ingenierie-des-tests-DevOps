# Copier ce fichier en .env (cp .env.exemple .env), puis le compléter.

# Compte administrateur de Jenkins
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=a-changer

# Adresse de VOTRE projet gitlab.com (public) : bouton Code > Clone with HTTPS
GITLAB_PROJET=https://gitlab.com/<votre-espace>/embarq.git

# Numéro du groupe docker de la machine : getent group docker | cut -d: -f3
DOCKER_GID=999
