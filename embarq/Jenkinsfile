// Pipeline d'Embarq, exécuté par le Jenkins du lab.
// Il est lancé par GitLab CI/CD à chaque push : voir .gitlab-ci.yml et embarq/ci/declencher-jenkins.sh.
pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        // Version de l'image Docker : construite une fois, déployée partout (e2e, preprod, prod)
        VERSION = "1.0.${env.BUILD_NUMBER}"
    }

    stages {
        stage('Compilation') {
            steps {
                dir('embarq') {
                    // clean : chaque build repart de zéro, mesures de couverture comprises
                    sh 'mvn -B clean compile'
                }
            }
        }

        stage('Tests unitaires') {
            steps {
                dir('embarq') {
                    sh 'mvn -B test'
                }
            }
            post {
                always {
                    junit 'embarq/target/surefire-reports/*.xml'
                    // Les scénarios Cucumber, lisibles par Maëlle : la documentation vivante des règles métier
                    publishHTML target: [
                        reportName : 'Scénarios Cucumber',
                        reportDir  : 'embarq/target/cucumber',
                        reportFiles: 'rapport.html',
                        keepAll    : true,
                        alwaysLinkToLastBuild: true,
                        allowMissing: true
                    ]
                }
            }
        }

        stage('Tests d\'intégration') {
            steps {
                dir('embarq') {
                    // Les tests unitaires sont déjà passés : on ne lance que les *IT (failsafe)
                    sh 'mvn -B verify -Dtests.unitaires.ignores=true'
                }
            }
            post {
                always {
                    junit 'embarq/target/failsafe-reports/*.xml'
                    // Couverture des tests unitaires et d'intégration (le seuil est vérifié par Maven : jacoco:check)
                    recordCoverage tools: [[parser: 'JACOCO', pattern: 'embarq/target/site/jacoco/jacoco.xml']]
                }
            }
        }

        stage('Paquet') {
            steps {
                dir('embarq') {
                    sh 'mvn -B package -DskipTests'
                }
                archiveArtifacts artifacts: 'embarq/target/embarq.jar', fingerprint: true
            }
        }

        stage('Image Docker') {
            steps {
                dir('embarq') {
                    sh 'docker build -t embarq:$VERSION .'
                }
            }
        }

        stage('Environnement e2e') {
            steps {
                dir('embarq') {
                    sh 'bash deploy/deployer.sh e2e $VERSION'
                }
            }
        }

        // TP 05 : l'étape « Tests end-to-end » se place ici
    }

    post {
        always {
            // L'environnement e2e ne sert que le temps du build : on le supprime, base comprise
            dir('embarq') {
                sh 'docker compose -p embarq-e2e --env-file deploy/e2e.env down -v || true'
            }
        }
    }
}
